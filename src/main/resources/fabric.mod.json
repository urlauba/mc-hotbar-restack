{
	"schemaVersion": 1,
	"id": "hotbar-restack",
	"version": "${version}",
	"name": "Hotbar Restack",
	"description": "Automatically refills your active hotbar slot as you use up a stack, pulling matching items from other hotbar slots or your inventory.",
	"authors": [
		"urlauba"
	],
	"contact": {
		"sources": "https://github.com/urlauba/mc-hotbar-restack"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.urlauba.hotbarrestack.HotbarRestack"
		],
		"client": [
			"io.github.urlauba.hotbarrestack.client.HotbarRestackClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
